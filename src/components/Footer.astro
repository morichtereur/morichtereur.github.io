---
import { NAME, EMAIL, LINKEDIN_URL, GITHUB_URL, CV_URL } from '../consts';
---

<footer class="site-footer">
  <div class="inner">
    <p class="name">{NAME}</p>
    <ul class="links">
      <li><a href={LINKEDIN_URL}>LinkedIn</a></li>
      <li><a href={GITHUB_URL}>GitHub</a></li>
      <li><a href={`mailto:${EMAIL}`}>Email</a></li>
      <li><a href={CV_URL}>CV</a></li>
    </ul>
  </div>
</footer>

<style>
  /* The band again — the page closes on the colour it opened with, so the
     white body reads as the sheet between two boards. */
  .site-footer {
    background: var(--color-band);
  }

  .site-footer :focus-visible {
    outline-color: var(--color-band-accent);
  }

  .inner {
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding: var(--space-6) var(--space-5) var(--space-7);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
  }

  .name,
  .links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-band-text-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .links a {
    text-decoration: none;
    padding-block: var(--space-1);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-band-accent);
  }
</style>
