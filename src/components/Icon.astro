---
/**
 * Inline SVG so there are no network requests and the mark inherits
 * currentColor, including link hover states.
 */
interface Props {
  name: 'linkedin' | 'email' | 'github';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="7.5" y1="10.5" x2="7.5" y2="16.5" />
        <line x1="7.5" y1="7.4" x2="7.5" y2="7.5" />
        <path d="M11.5 16.5v-6M11.5 13.2a2.7 2.7 0 0 1 5 0v3.3" />
      </>
    )
  }
  {
    name === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
    )
  }
</svg>

<style>
  .icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }
</style>
