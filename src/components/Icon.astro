---
/**
 * Inline SVG so there are no network requests and the mark inherits
 * currentColor, including link hover states.
 */
interface Props {
  name:
    | 'linkedin'
    | 'email'
    | 'github'
    | 'cv'
    | 'globe'
    | 'pulse'
    | 'radar'
    | 'layers'
    | 'database'
    | 'arrow';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="7.5" y1="10.5" x2="7.5" y2="16.5" />
        <line x1="7.5" y1="7.4" x2="7.5" y2="7.5" />
        <path d="M11.5 16.5v-6M11.5 13.2a2.7 2.7 0 0 1 5 0v3.3" />
      </>
    )
  }
  {
    name === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6 8.5-6" />
      </>
    )
  }
  {
    name === 'cv' && (
      <>
        <path d="M6 2.5h8l4 4V21a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5Z" />
        <path d="M14 2.5V7h4" />
        <line x1="9" y1="11.5" x2="15" y2="11.5" />
        <line x1="9" y1="15" x2="15" y2="15" />
      </>
    )
  }
  {
    name === 'github' && (
      <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
    )
  }
  {
    name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c3 3.4 3 14.6 0 18M12 3c-3 3.4-3 14.6 0 18" />
      </>
    )
  }
  {
    name === 'pulse' && (
      <path d="M3 12h3.5L9 6l4.5 12L16 12h5" />
    )
  }
  {
    name === 'radar' && (
      <>
        <circle cx="5.5" cy="18.5" r="1" fill="currentColor" stroke="none" />
        <path d="M5.5 12.5a6 6 0 0 1 6 6" />
        <path d="M5.5 7a11.5 11.5 0 0 1 11.5 11.5" />
        <path d="M5.5 2.5A17 17 0 0 1 21.5 18.5" />
      </>
    )
  }
  {
    name === 'layers' && (
      <>
        <path d="m12 3 9 5-9 5-9-5 9-5Z" />
        <path d="m3.8 12.7 8.2 4.6 8.2-4.6" />
        <path d="m3.8 16.4 8.2 4.6 8.2-4.6" />
      </>
    )
  }
  {
    name === 'database' && (
      <>
        <ellipse cx="12" cy="5.5" rx="7.5" ry="2.8" />
        <path d="M4.5 5.5v13c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8v-13" />
        <path d="M4.5 12c0 1.5 3.4 2.8 7.5 2.8s7.5-1.3 7.5-2.8" />
      </>
    )
  }
  {
    name === 'arrow' && (
      <>
        <path d="M6.5 17.5 17.5 6.5" />
        <path d="M8.5 6.5h9v9" />
      </>
    )
  }
</svg>

<style>
  .icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }
</style>
