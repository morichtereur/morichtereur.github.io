---
import { Image } from 'astro:assets';
import { NAME, EMAIL, LINKEDIN_URL } from '../consts';
import moritzPhoto from '../assets/moritz.jpg';
---

<section class="hero">
  <div class="inner">
    <div class="text">
      <h1>{NAME}</h1>
      <p class="positioning">Finance and strategy consultant. I build the AI systems behind the advice.</p>
      <p class="subline">CFO advisory and global business services at EY, in Zürich. Previously KPMG.</p>
      <div class="links">
        <a href={LINKEDIN_URL}>LinkedIn <span aria-hidden="true">&rarr;</span></a>
        <a href={`mailto:${EMAIL}`}>Email <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
    <div class="photo">
      <Image src={moritzPhoto} alt={`Photo of ${NAME}`} width={900} format="webp" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-8);
  }

  .inner {
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-7);
  }

  .text {
    flex: 1 1 26rem;
    min-width: 0;
  }

  .photo {
    flex: 0 0 auto;
    width: clamp(11rem, 24vw, 15rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(1.05);
  }

  h1 {
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .positioning {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 32ch;
  }

  .subline {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
    max-width: 40ch;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .links a {
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-1);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .links a span {
    color: var(--color-accent);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }
</style>
