---
import { Image } from 'astro:assets';
import { NAME, EMAIL, LINKEDIN_URL, GITHUB_URL, CV_URL } from '../consts';
import Icon from './Icon.astro';
import moritzPhoto from '../assets/moritz.jpg';
---

<section class="hero">
  {/* The ground behind the band: three sheets of near-tone viridian and two
      hairlines, drawn once and left alone. Slice-fitted so the curves stay
      curves at any width; decorative, so hidden from readers. */}
  <svg
    class="flow"
    viewBox="0 0 1440 640"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <path d="M0 400 C 360 300, 760 480, 1440 330 L 1440 640 L 0 640 Z" fill="#154437"></path>
    <path d="M0 500 C 420 400, 920 580, 1440 440 L 1440 640 L 0 640 Z" fill="#0d2f24"></path>
    <path d="M0 580 C 480 500, 980 640, 1440 540 L 1440 640 L 0 640 Z" fill="#1a4e3e"></path>
    <path
      d="M0 430 C 380 330, 780 500, 1440 355"
      fill="none"
      stroke="rgba(238, 240, 233, 0.12)"
      stroke-width="1"></path>
    <path
      d="M0 530 C 440 430, 940 600, 1440 465"
      fill="none"
      stroke="rgba(238, 240, 233, 0.08)"
      stroke-width="1"></path>
  </svg>

  <div class="inner">
    <div class="text">
      <p class="eyebrow">Zürich · Finance Transformation &amp; AI</p>
      <h1>{NAME}</h1>
      <p class="positioning">
        I use data and AI to diagnose, quantify, and improve finance operations.
      </p>
      <p class="subline">
        Finance transformation consultant, working across GBS, operating models, performance
        management and applied AI.
      </p>
      <div class="links">
        <a href={LINKEDIN_URL}><Icon name="linkedin" />LinkedIn</a>
        <a href={GITHUB_URL}><Icon name="github" />GitHub</a>
        <a href={`mailto:${EMAIL}`}><Icon name="email" />Email</a>
        <a href={CV_URL}><Icon name="cv" />CV</a>
      </div>
    </div>
    <div class="photo">
      <Image
        src={moritzPhoto}
        alt={`Photo of ${NAME}`}
        width={900}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* Full-bleed band. The page opens on the signal colour instead of mentioning
     it, and everything on the band uses the band roles from tokens.css. */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-band);
    color: var(--color-band-text);
    /* The nav is fixed and floats over the band, so the band itself clears
       it: nav offset + bar height + breathing room, then the display scale. */
    padding-block: calc(4.75rem + clamp(2.5rem, 7vw, 5rem)) clamp(4rem, 9vw, 6.5rem);
  }

  .flow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* A soft light falling from the upper left — depth the flat fill lacks,
     kept far below the threshold where it would read as an effect. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 15% -10%,
      rgba(238, 240, 233, 0.07),
      transparent 60%
    );
    pointer-events: none;
  }

  /* The page-level focus ring is accent-on-bone; on the band it needs the
     on-band accent to be visible at all. */
  .hero :focus-visible {
    outline-color: var(--color-band-accent);
  }

  .inner {
    position: relative;
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: end;
    gap: var(--space-6);
  }

  .text {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-band-text-secondary);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-band-line);
  }

  /* Serif display on the band — the one place the site raises its voice.
     Everywhere else the serif is the body face; here it carries the headline,
     so the weight stays at 600 and the size does the work. */
  h1 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .positioning {
    font-family: var(--font-serif);
    margin-top: var(--space-5);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 31rem;
    text-wrap: pretty;
  }

  .subline {
    font-family: var(--font-serif);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-band-text-secondary);
    max-width: 31rem;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  /* Frosted chips: the one place the glass vocabulary appears on the band
     itself. The blur picks up the flow sheets moving behind each chip, so
     they read as cut from the band rather than laid on it. */
  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-band-text);
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.07);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(238, 240, 233, 0.25);
    border-radius: 999px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .links a:hover,
  .links a:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(238, 240, 233, 0.55);
    color: var(--color-band-text);
  }

  .photo {
    width: clamp(9rem, 20vw, 14rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-band-line);
    border-radius: 50%;
    /* Lifted off the band by shadow rather than outline — the same depth
       grammar as the nav bar. */
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.28);
  }

  /* Source is landscape 3:2 with the subject right of centre, so a square
     cover crop fills the height and leaves him off-axis. Scale and origin are
     solved to put the head on the circle's vertical axis with the eye line at
     43% height, at ~60% of the diameter. On the band the crop keeps its
     grayscale but drops the multiply — there is no paper to multiply onto. */
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.38);
    transform-origin: 67.7% 6.6%;
    filter: grayscale(1) contrast(1.04);
  }

  @media (max-width: 760px) {
    .hero {
      /* The fixed bar can wrap to two rows at phone widths, so the clearance
         is generous rather than exact. */
      padding-block: 6.5rem var(--space-7);
    }

    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .photo {
      order: -1;
      width: clamp(7rem, 32vw, 9rem);
    }
  }
</style>
