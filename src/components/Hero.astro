---
import { Image } from 'astro:assets';
import { NAME, EMAIL, LINKEDIN_URL, GITHUB_URL, CV_URL } from '../consts';
import Icon from './Icon.astro';
import moritzPhoto from '../assets/moritz.jpg';
---

<section class="hero">
  <div class="inner">
    <div class="text">
      <p class="eyebrow">Zürich · Finance Transformation &amp; AI</p>
      <h1>{NAME}</h1>
      <p class="positioning">
        I use data and AI to diagnose, quantify, and improve finance operations.
      </p>
      <p class="subline">
        Finance transformation consultant, working across GBS, operating models, performance
        management and applied AI.
      </p>
      <div class="links">
        <a href={LINKEDIN_URL}><Icon name="linkedin" />LinkedIn</a>
        <a href={GITHUB_URL}><Icon name="github" />GitHub</a>
        <a href={`mailto:${EMAIL}`}><Icon name="email" />Email</a>
        <a href={CV_URL}><Icon name="cv" />CV</a>
      </div>
    </div>
    <div class="photo">
      <Image
        src={moritzPhoto}
        alt={`Photo of ${NAME}`}
        width={900}
        format="webp"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .inner {
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    /* The text column was 1fr, so it stretched to the full width while the copy
       kept its reading measure -- 638px of column carrying 414px of text, and
       the portrait pushed 305px away from the words it belongs to. Content-sized
       columns packed left put it back beside them. */
    grid-template-columns: auto auto;
    justify-content: start;
    align-items: end;
    gap: var(--space-6);
  }

  .text {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-secondary);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  /* Both paragraphs used a ch-based reading measure — 30ch and 46ch — while the
     column itself is sized by the headline, which reaches ~31rem once the h1
     hits its 5rem cap. The copy therefore stopped 60-100px short of the rule
     above it, and the portrait read as pushed away from words that had simply
     stopped early. Capping both at the headline's own width makes the text a
     single block, and the gap to the photo the 2rem it always was. */
  .positioning {
    font-family: var(--font-serif);
    margin-top: var(--space-5);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 31rem;
    text-wrap: pretty;
  }

  /* Steps down from the positioning line rather than competing with it: the
     claim reads first, the scope second. */
  .subline {
    font-family: var(--font-serif);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
    max-width: 31rem;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-border-strong);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .photo {
    width: clamp(9rem, 20vw, 14rem);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
  }

  /* Source is landscape 3:2 with the subject right of centre, so a square
     cover crop fills the height and leaves him off-axis. Scale and origin are
     solved to put the head on the circle's vertical axis with the eye line at
     43% height, at ~60% of the diameter. */
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.38);
    transform-origin: 67.7% 6.6%;
    filter: grayscale(1) contrast(1.04);
    mix-blend-mode: multiply;
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--space-6) var(--space-6);
    }

    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .photo {
      order: -1;
      width: clamp(7rem, 32vw, 9rem);
    }
  }
</style>
