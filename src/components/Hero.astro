---
import { Image } from 'astro:assets';
import { NAME, EMAIL, LINKEDIN_URL } from '../consts';
import moritzPhoto from '../assets/moritz.jpg';
---

<section class="hero">
  <div class="inner">
    <div class="text">
      <p class="eyebrow">Zürich · Finance &amp; Strategy</p>
      <h1>{NAME}</h1>
      <p class="positioning">
        Finance and strategy consultant. I build the AI systems behind the advice.
      </p>
      <p class="subline">CFO advisory and global business services at EY, in Zürich. Previously KPMG.</p>
      <div class="links">
        <a href={LINKEDIN_URL}>LinkedIn</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
      </div>
    </div>
    <div class="photo">
      <Image src={moritzPhoto} alt={`Photo of ${NAME}`} width={900} format="webp" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .inner {
    max-width: var(--content-width-wide);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-7);
  }

  .text {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-secondary);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .positioning {
    font-family: var(--font-serif);
    margin-top: var(--space-5);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 26ch;
    text-wrap: pretty;
  }

  .subline {
    font-family: var(--font-serif);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
    max-width: 42ch;
    text-wrap: pretty;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-accent);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--color-border-strong);
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent-hover);
    border-color: var(--color-accent);
  }

  .photo {
    width: clamp(9rem, 18vw, 13rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
  }

  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(1) contrast(1.04);
    mix-blend-mode: multiply;
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--space-6) var(--space-6);
    }

    .inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }

    .photo {
      order: -1;
      width: clamp(7rem, 32vw, 9rem);
    }
  }
</style>
