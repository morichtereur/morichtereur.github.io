---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SignalField from './SignalField.astro';

interface Props {
  title: string;
  /** One plain sentence saying what the thing is, read before any of the
   *  detail below it. The problem/build pair explains why it exists and how it
   *  was made; neither answers "what is this" in the time a reader gives it. */
  summary: string;
  /** Where the data came from, in a few words. Stated per project because a
   *  reader has to be able to see that none of it is client material without
   *  taking a blanket claim on trust. */
  data: string;
  problem: string;
  build: string;
  stack: string[];
  metricValue: string;
  metricLabel: string;
  /** The commercial consequence of the finding. The outcome says what the
   *  number is; this says why anyone should act on it. */
  implication: string;
  repoUrl?: string;
  /** A deployed, working version. Carried separately from repoUrl and styled
   *  louder: reading code and using the thing are different offers, and only
   *  one of them survives a reader who does not code. */
  demoUrl?: string;
  /** `blend` multiplies a white-background chart onto the paper, so it sits on
   *  the page rather than floating in a white panel. */
  figure?: { src: ImageMetadata; alt: string; caption: string; blend?: boolean };
  /** The scored/reached-brief ratio behind the outcome metric, rendered as a
   *  field of marks. Only meaningful once the reader already knows what's
   *  being counted, so it lives in the outcome row rather than the page. */
  signal?: { total: number; signal: number };
  /** A featured card renders at full depth on the page. The rest open with
   *  summary, data and outcome, and fold the long-form fields behind a native
   *  disclosure — most readers give the page ninety seconds, and nine cards of
   *  equal weight spend that budget before the strongest work is reached.
   *  Nothing is removed: the full case study is one click away, with no
   *  JavaScript in the path. */
  featured?: boolean;
}

const {
  title,
  summary,
  data,
  problem,
  build,
  stack,
  metricValue,
  metricLabel,
  implication,
  repoUrl,
  demoUrl,
  figure,
  signal,
  featured = false,
} = Astro.props;
---

<article class:list={['case-study', { 'is-compact': !featured }]} data-reveal>
  <header>
    <h4>{title}</h4>
    <div class="links">
      {
        demoUrl && (
          <a class="demo" href={demoUrl}>
            Live demo <span aria-hidden="true">↗</span>
          </a>
        )
      }
      {
        repoUrl && (
          <a class="repo" href={repoUrl}>
            Source <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </header>

  <p class="summary">{summary}</p>
  <p class="data"><span>Data</span>{data}</p>

  {
    featured ? (
      <>
        <dl>
          <dt>Problem</dt>
          <dd>{problem}</dd>

          <dt>What I built</dt>
          <dd>{build}</dd>

          <dt>Stack</dt>
          <dd class="stack">
            {stack.map((item) => (
              <span class="tag">{item}</span>
            ))}
          </dd>

          <dt>Outcome</dt>
          <dd class="outcome">
            <span class="metric-value">{metricValue}</span>
            <span class="metric-label">{metricLabel}</span>
            {signal && (
              <div class="signal-wrap">
                <SignalField total={signal.total} signal={signal.signal} />
              </div>
            )}
          </dd>

          <dt>So what</dt>
          <dd>{implication}</dd>
        </dl>
        {figure && (
          <figure class={figure.blend ? 'shot is-blended' : 'shot'}>
            <Image
              src={figure.src}
              alt={figure.alt}
              widths={[700, 1100]}
              sizes="(max-width: 48rem) 100vw, 44rem"
            />
            <figcaption>{figure.caption}</figcaption>
          </figure>
        )}
      </>
    ) : (
      <>
        <p class="outcome outcome-row">
          <span class="metric-value">{metricValue}</span>
          <span class="metric-label">{metricLabel}</span>
          {signal && (
            <span class="signal-wrap">
              <SignalField total={signal.total} signal={signal.signal} />
            </span>
          )}
        </p>
        <details class="more">
          <summary>Full case study</summary>
          <dl>
            <dt>Problem</dt>
            <dd>{problem}</dd>

            <dt>What I built</dt>
            <dd>{build}</dd>

            <dt>Stack</dt>
            <dd class="stack">
              {stack.map((item) => (
                <span class="tag">{item}</span>
              ))}
            </dd>

            <dt>So what</dt>
            <dd>{implication}</dd>
          </dl>
          {figure && (
            <figure class={figure.blend ? 'shot is-blended' : 'shot'}>
              <Image
                src={figure.src}
                alt={figure.alt}
                widths={[700, 1100]}
                sizes="(max-width: 48rem) 100vw, 44rem"
              />
              <figcaption>{figure.caption}</figcaption>
            </figure>
          )}
        </details>
      </>
    )
  }
</article>

<style>
  .case-study {
    padding-block: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  /* A compact card holds less, so it earns less vertical ground; the featured
     cards keep the full measure and the size contrast is what says
     "start here" without a label saying it. */
  .case-study.is-compact {
    padding-block: var(--space-6);
  }

  /* The first card in a group sits directly under the group heading's own
     rule. Matching on type, not position: .group-head is the element's first
     child, so :first-child matched nothing and the divider doubled up. */
  .case-study:first-of-type {
    border-top: 0;
    padding-top: var(--space-2);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-bottom: var(--space-6);
  }

  .is-compact header {
    margin-bottom: var(--space-4);
  }

  /* Serif, like every headline from the hero down — the grotesque now speaks
     only where data does (metric values, nothing else). */
  h4 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: -0.015em;
  }

  .summary {
    margin: var(--space-3) 0 0;
    max-width: 46rem;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .data {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    align-items: baseline;
    margin: var(--space-3) 0 0;
    max-width: 46rem;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .data span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-4);
  }

  .demo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .demo:hover,
  .demo:focus-visible {
    color: var(--color-accent-hover);
  }

  .repo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .repo:hover,
  .repo:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  dl {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    row-gap: var(--space-5);
    column-gap: var(--space-5);
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-secondary);
    padding-top: 0.45em;
  }

  dd {
    margin: 0;
    font-family: var(--font-serif);
    line-height: var(--leading-normal);
    text-wrap: pretty;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-2);
  }

  .outcome {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }

  /* On a compact card the outcome is the whole argument above the fold, so it
     stands as its own row instead of a dl entry. */
  .outcome-row {
    margin: var(--space-4) 0 0;
    max-width: 46rem;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent);
  }

  .metric-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .signal-wrap {
    display: block;
    flex-basis: 100%;
    margin-top: var(--space-4);
  }

  /* The fold. A native disclosure, so it works with no JavaScript and costs a
     reader one click; the summary sits in the same register as the card's
     links because it is one — an offer, not a heading. */
  .more {
    margin-top: var(--space-5);
  }

  .more summary {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent);
    cursor: pointer;
    list-style: none;
    border-bottom: 1px solid var(--color-border-strong);
    padding-bottom: 0.15rem;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary::before {
    content: '+';
    font-family: var(--font-mono);
  }

  .more[open] summary::before {
    content: '−';
  }

  .more summary:hover,
  .more summary:focus-visible {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  .more[open] summary {
    margin-bottom: var(--space-6);
  }

  .shot {
    margin: var(--space-6) 0 0;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-strong);
  }

  /* Charts render on white. Multiplying drops that white to the paper colour
     without touching the ink, so the plot sits on the page instead of in a
     bright panel — and anti-aliased edges blend correctly for free. */
  .shot.is-blended :global(img) {
    mix-blend-mode: multiply;
    border: 0;
  }

  .shot figcaption {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-text-secondary);
  }

  @media (max-width: 600px) {
    dl {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-2);
    }

    dt {
      padding-top: var(--space-4);
    }
  }
</style>
