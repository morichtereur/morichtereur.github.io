---
import { NAME, EMAIL } from '../consts';
---

<header class="site-header">
  <div class="inner">
    <span class="wordmark">{NAME}</span>
    <nav aria-label="Primary">
      <a href="#case-studies">Case Studies</a>
      <a href={`mailto:${EMAIL}`}>Contact</a>
    </nav>
  </div>
</header>

<style>
  /* The nav floats as a detached glass bar instead of owning a full-width
     strip: fixed, inset from the edges, frosted over whatever passes under
     it — the viridian band at the top, white paper once the page scrolls.
     The hero clears it with its own top padding. */
  .site-header {
    position: fixed;
    top: var(--space-3);
    left: 0;
    right: 0;
    z-index: 50;
    padding-inline: var(--space-3);
  }

  .inner {
    max-width: var(--content-width-wide);
    margin-inline: auto;
    min-height: 3.25rem;
    padding-inline: var(--space-5);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    background: rgba(255, 255, 255, 0.68);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    border: 1px solid rgba(18, 26, 23, 0.08);
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(18, 26, 23, 0.07);
  }

  /* No frost, no translucency — a browser that cannot blur gets a solid bar
     rather than text floating over text. */
  @supports not (backdrop-filter: blur(1px)) {
    .inner {
      background: rgba(255, 255, 255, 0.96);
    }
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-secondary);
    text-decoration: none;
    padding-block: var(--space-2);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent);
  }
</style>
