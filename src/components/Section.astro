---
interface Props {
  id: string;
  heading: string;
}

const { id, heading } = Astro.props;
---

<section {id} class="section">
  <div class="inner">
    <div class="head" data-reveal>
      <h2>{heading}</h2>
    </div>
    <div class="content">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-8);
  }

  .inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border-strong);
  }

  /* The section title takes the serif at display scale — the same register the
     hero establishes on the band, carried onto the paper. The mono small-caps
     that used to sit here now belongs to eyebrows and labels only. */
  h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-text-primary);
    text-wrap: balance;
  }

  .content {
    margin-top: var(--space-6);
  }
</style>
