---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import explorerShot from '../assets/intelligence-explorer.png';
import variantCoverage from '../assets/p2p-variant-coverage.png';
import gbsTornado from '../assets/gbs-tornado.png';
import daxAnswer from '../assets/dax-intelligence-answer.png';
import agenticMix from '../assets/gbs-agentic-mix.png';

const caseStudies = [
  {
    title: 'P2P Process Mining',
    problem:
      'Every finance transformation deck opens with the same sentence — the process is inefficient and highly manual. Almost nobody can say by how much, or where.',
    build:
      'Mined a 1.6M-event SAP purchase-to-pay log covering 251,734 purchase order line items, reconstructing the path each case actually took rather than the one the process documentation describes. Variant analysis, straight-through rate, the cycle-time cost of rework, and which sequence rules the system genuinely enforces versus merely documents.',
    stack: ['Python', 'DuckDB', 'Claude API', 'Matplotlib'],
    metricValue: '20%',
    metricLabel: 'of cases follow the most common path; rework costs 19.6 days',
    repoUrl: 'https://github.com/morichtereur/p2p-process-mining',
    figure: {
      src: variantCoverage,
      alt: 'Cumulative share of cases covered as more process variants are included, on a log-scaled rank axis. The curve rises steeply then flattens: 50% of cases at rank 7, 90% at rank 232, 99% only at rank 9,456.',
      caption:
        'Coverage against variant rank. Half the cases sit in seven variants; the last percent needs nine thousand more.',
      blend: true,
    },
  },
  {
    title: 'GBS Agentic Shift',
    problem:
      'McKinsey argues agentic AI is turning the GBS talent pyramid into a diamond — a shrinking transactional base and a new layer managing the agent force. It is a claim about what work looks like, cited far more often than it is checked.',
    build:
      'Read the claim off the labour market instead. Pulled 2,110 live GBS and finance-operations postings across ten markets and classified each as transactional, judgment or agent-ops — a visible phrase taxonomy carries the headline, an LLM decides only the ambiguous residual, and the classifier\'s own accuracy is measured against a hand-labelled gold set rather than asserted. Splitting by employer produces the sharpest result: captive GBS hires 38% transactional, third-party providers 84%. The base did not shrink so much as change employer, and only that cut tells outsourcing apart from automation.',
    stack: ['Python', 'DuckDB', 'Claude API', 'Matplotlib'],
    metricValue: '2%',
    metricLabel: 'of postings ask for agent-ops skills — the diamond is not visible yet',
    repoUrl: 'https://github.com/morichtereur/gbs-agentic-shift',
    figure: {
      src: agenticMix,
      alt: 'A single stacked bar across 2,110 GBS job postings: transactional 44%, judgment 55%, and a thin agent-ops sliver at 2% annotated in orange at the right edge.',
      caption:
        'Ten markets, one point-in-time cross-section. A measured 42.9% recall on the agent-ops class makes that 2% a lower bound rather than a ceiling — the classifier reports how wrong it is, so the finding can be read honestly.',
      blend: true,
    },
  },
  {
    title: 'GBS Intelligence Agent',
    problem:
      'Competitor and client intelligence reached the team through whoever happened to read the right article — usually weeks after it could have changed a proposal.',
    build:
      'A pipeline that reads 69 feeds across 33 consulting firms, analyst houses and client companies, then has Claude score every article 0–3 for strategic relevance. Only the top tier reaches the Monday brief; everything below the cut stays searchable in a dashboard.',
    stack: ['Python', 'Claude API', 'SQLite'],
    metricValue: '16 weeks',
    metricLabel: 'delivered end to end, no manual step',
    repoUrl: 'https://github.com/morichtereur/gbs-intelligence-agent',
    signal: { total: 1132, signal: 30 },
    figure: {
      src: explorerShot,
      alt: 'The Intelligence Explorer dashboard: a filter bar above a grid of article cards, each carrying a source logo, topic tags and a relevance badge. Text is obscured.',
      caption:
        'The Intelligence Explorer — one card per signal, grouped by cluster, filtered by topic and calendar week. Content obscured; the live dashboard carries competitive intelligence.',
    },
  },
  {
    title: 'DAX Intelligence',
    problem:
      'Answering one comparative question across a set of annual reports means opening every PDF and trusting your memory of what each one said.',
    build:
      'Retrieval across 15 DAX 40 annual reports. ChromaDB surfaces the relevant passages and Claude synthesises them behind a prompt that will not answer without a source, so every claim comes back with a company and a page number.',
    stack: ['Python', 'ChromaDB', 'Claude API', 'Streamlit'],
    metricValue: '15 reports',
    metricLabel: 'answerable in one query, with page citations',
    repoUrl: 'https://github.com/morichtereur/dax-intelligence',
    figure: {
      src: daxAnswer,
      alt: 'A synthesised research memo comparing how Siemens and SAP frame AI investment strategy, each claim followed by an inline (Company Year, p.N) citation. Below it a green "VERIFIED — 8/8 citations matched retrieved excerpts exactly" badge, an export button, and the start of an audit trail table listing each retrieved excerpt with its page range and confidence score.',
      caption:
        'A real query against the 2025 filings. Every claim carries a page citation, and every citation is checked against the retrieved excerpt before it reaches the screen.',
    },
  },
  {
    title: 'GBS Business Case',
    problem:
      'A shared-services business case usually rests on numbers guessed in a workshop — automation rate, rework share, handling time — presented as if they were measured.',
    build:
      'Built the case on the P2P Process Mining baseline instead: opportunity sizing and discounted cash flows from the measured straight-through rate and rework cost, then a 10,000-draw Monte Carlo across every assumption still uncertain. Each one is tagged whether diligence could resolve it or genuinely cannot yet, so the variance in the answer sorts into a work plan rather than a caveat.',
    stack: ['Python', 'DuckDB', 'NumPy', 'Matplotlib'],
    metricValue: '62%',
    metricLabel: 'of NPV variance comes from assumptions diligence can resolve — the work plan, not the caveat',
    repoUrl: 'https://github.com/morichtereur/gbs-business-case',
    figure: {
      src: gbsTornado,
      alt: 'Horizontal tornado chart of NPV sensitivity by assumption, low value to high value, bars coloured by whether diligence could measure the assumption or not. Minutes per rework touch, a measurable assumption, produces the widest swing — ahead of the implementation one-off cost.',
      caption:
        'The widest swing comes from a measurable assumption, not the implementation cost quote — the opposite of what a workshop case usually assumes.',
      blend: true,
    },
  },
];
---

<BaseLayout>
  <Hero />
  <Section id="case-studies" heading="Case Studies">
    {caseStudies.map((cs) => <CaseStudyCard {...cs} />)}
  </Section>
</BaseLayout>
